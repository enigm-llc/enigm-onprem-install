#!/usr/bin/env python3
"""Offline release verification and rootless Linux lifecycle. No network bootstrap."""
import argparse
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile


class Rejected(Exception):
    pass


def require(condition, code):
    if not condition:
        raise Rejected(code)


def digest(path):
    result = hashlib.sha256()
    with opened_file(Path(path)) as (descriptor, before):
        size = 0
        while chunk := os.read(descriptor, 1024 * 1024):
            result.update(chunk)
            size += len(chunk)
        require(size == before.st_size and stable_file_info(before, os.fstat(descriptor)), 'FILE_REFERENCE_CHANGED')
    return result.hexdigest()


@contextlib.contextmanager
def parent_descriptor(path):
    path = Path(path)
    require(path.is_absolute() and '..' not in path.parts and path.name not in ('', '.', '..'), 'FILE_REFERENCE_INVALID')
    descriptor = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    system_owner = os.fstat(descriptor).st_uid
    try:
        for part in path.parent.parts[1:]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
            info = os.fstat(descriptor)
            require(info.st_uid in (system_owner, os.getuid()) and info.st_mode & 0o022 == 0, 'ANCESTOR_PERMISSIONS_INVALID')
        yield descriptor
    except OSError:
        raise Rejected('FILE_REFERENCE_INVALID') from None
    finally:
        os.close(descriptor)


@contextlib.contextmanager
def opened_file(path, private=False, limit=512 * 1024 * 1024):
    with parent_descriptor(path) as parent:
        descriptor = None
        try:
            descriptor = os.open(Path(path).name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
            before = os.fstat(descriptor)
            require(stat.S_ISREG(before.st_mode) and before.st_uid == os.getuid() and before.st_nlink == 1, 'FILE_OWNER_INVALID')
            require(0 <= before.st_size <= limit, 'FILE_SIZE_INVALID')
            require(before.st_mode & (0o077 if private else 0o022) == 0, 'FILE_PERMISSIONS_INVALID')
            yield descriptor, before
        except OSError:
            raise Rejected('FILE_REFERENCE_INVALID') from None
        finally:
            if descriptor is not None:
                os.close(descriptor)


def stable_file_info(before, after):
    fields = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_nlink', 'st_mode', 'st_uid')
    return all(getattr(before, field) == getattr(after, field) for field in fields)


def read_file_bytes(path, limit=65536, private=False):
    with opened_file(Path(path), private, limit) as (descriptor, before):
        parts = []
        size = 0
        while True:
            part = os.read(descriptor, min(65536, limit + 1 - size))
            if not part:
                break
            parts.append(part)
            size += len(part)
            require(size <= limit, 'FILE_SIZE_INVALID')
        require(size == before.st_size and stable_file_info(before, os.fstat(descriptor)), 'FILE_REFERENCE_CHANGED')
        return b''.join(parts)


def read_private_bytes(path, limit=65536):
    return read_file_bytes(path, limit, True)


def regular(path, private=False):
    with opened_file(Path(path), private):
        return Path(path)


def private_directory(path):
    path = Path(path)
    with parent_descriptor(path / '.directory-check') as descriptor:
        info = os.fstat(descriptor)
        require(info.st_uid == os.getuid() and info.st_mode & 0o077 == 0, 'PRIVATE_DIRECTORY_INVALID')
    return path


def write_private_bytes(path, content):
    with parent_descriptor(path) as parent:
        info = os.fstat(parent)
        require(info.st_uid == os.getuid() and info.st_mode & 0o077 == 0, 'PRIVATE_DIRECTORY_INVALID')
        descriptor = os.open(Path(path).name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent)
        with os.fdopen(descriptor, 'wb') as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
    return Path(path)


def snapshot_secret_files(files, directory):
    private_directory(directory)
    require(isinstance(files, dict) and len(files) <= 20, 'SECRET_REFERENCE_SCOPE_INVALID')
    snapshots = {}
    paths = set()
    for name, source in files.items():
        require(isinstance(name, str) and re.fullmatch(r'[a-z][a-z0-9_]{0,40}', name), 'SERVICE_NAME_INVALID')
        path = Path(source)
        require(str(path) not in paths, 'SHARED_SERVICE_SECRETS_REJECTED')
        paths.add(str(path))
        snapshots[name] = write_private_bytes(Path(directory) / (name + '.env'), read_private_bytes(path))
    return snapshots


def run(command, capture=False, timeout=120):
    # Provider output can contain credentials. Never echo stdout/stderr on failure.
    result = subprocess.run(command, env=command_environment(Path.home()), stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout, check=False)
    if result.returncode and result.stderr == b'OCI_CLASSIC_IMAGE_STORE_REQUIRED\n':
        raise Rejected('OCI_CLASSIC_IMAGE_STORE_REQUIRED')
    require(result.returncode == 0, 'SUBPROCESS_FAILED')
    return result.stdout if capture else b''


def verify(bundle, expected, key, key_digest):
    require(re.fullmatch(r'[a-f0-9]{64}', expected or ''), 'MANIFEST_PIN_REQUIRED')
    require(re.fullmatch(r'[a-f0-9]{64}', key_digest or ''), 'PUBLISHER_KEY_PIN_INVALID')
    publisher = read_file_bytes(key)
    require(hashlib.sha256(publisher).hexdigest() == key_digest, 'PUBLISHER_KEY_PIN_INVALID')
    manifest_path = regular(bundle / 'manifest.json')
    require(manifest_path.stat().st_size <= 65536, 'MANIFEST_TOO_LARGE')
    require(digest(manifest_path) == expected, 'MANIFEST_CHECKSUM_INVALID')
    signature = regular(bundle / 'manifest.sig')
    require(signature.stat().st_size == 64, 'SIGNATURE_INVALID')
    encoded_manifest = read_file_bytes(manifest_path)
    encoded_signature = read_file_bytes(signature)
    require(hashlib.sha256(encoded_manifest).hexdigest() == expected and len(encoded_signature) == 64, 'SIGNATURE_INVALID')
    with tempfile.TemporaryDirectory(prefix='.enigm-signature-', dir=Path.home()) as name:
        directory = Path(name)
        directory.chmod(0o700)
        public_copy = write_private_bytes(directory / 'publisher.pub', publisher)
        manifest_copy = write_private_bytes(directory / 'manifest.json', encoded_manifest)
        signature_copy = write_private_bytes(directory / 'manifest.sig', encoded_signature)
        spki = run(['openssl', 'pkey', '-pubin', '-in', str(public_copy), '-outform', 'DER'], True)
        require(len(spki) == 44 and spki.startswith(bytes.fromhex('302a300506032b6570032100')), 'PUBLISHER_KEY_ALGORITHM_INVALID')
        run(['openssl', 'pkeyutl', '-verify', '-pubin', '-inkey', str(public_copy), '-rawin',
             '-in', str(manifest_copy), '-sigfile', str(signature_copy)])
    manifest = json.loads(encoded_manifest)
    require(manifest.get('contract') == 'enigm-onprem-release-v2' and manifest.get('product') == '2.1', 'CONTRACT_INVALID')
    require(manifest.get('authAuthority') == 'ENIGM_CENTRAL_BACKEND_V2', 'AUTH_AUTHORITY_INVALID')
    require(manifest.get('offlineUnlock') is False, 'OFFLINE_BYPASS_REJECTED')
    assets = manifest.get('assets')
    require(isinstance(assets, dict) and 1 <= len(assets) <= 1000 and 'compose.json' in assets, 'ASSETS_INVALID')
    total = 0
    for name, entry in assets.items():
        relative = Path(name)
        require(not relative.is_absolute() and '..' not in relative.parts and '\\' not in name,
                'ASSET_PATH_INVALID')
        source = bundle / relative
        require(source.resolve().is_relative_to(bundle.resolve()), 'ASSET_PATH_INVALID')
        regular(source)
        require(isinstance(entry, dict) and entry.get('sha256') == digest(source), 'ASSET_CHECKSUM_INVALID')
        require(entry.get('size') == source.stat().st_size, 'ASSET_SIZE_INVALID')
        total += entry['size']
    require(total <= 512 * 1024 * 1024, 'BUNDLE_TOO_LARGE')
    compose = json.loads(read_file_bytes(bundle / 'compose.json'))
    validate_compose(compose)
    image = compose.get('services', {}).get('channel', {}).get('image', '')
    if image.startswith('sha256:'):
        require(manifest.get('backendChannelImage') == image and manifest.get('backendImagePayloadVerified') is True and 'backend-v2.oci.tar' in assets and re.fullmatch('[a-f0-9]{40}', manifest.get('backendSourceSha', '')), 'LOCAL_IMAGE_PROVENANCE_REQUIRED')
    validate_storage_image(manifest, compose)
    return manifest


def validate_storage_image(manifest, compose):
    image = compose.get('services', {}).get('storage', {}).get('image', '')
    fields = ('storageImage', 'storageSourceSha', 'storageRuntimeUid')
    assets = manifest.get('assets', {})
    local = image.startswith('sha256:')
    expected_oci = {'backend-v2.oci.tar'} if manifest.get('backendChannelImage', '').startswith('sha256:') else set()
    if local:
        expected_oci.add('storage-v2.oci.tar')
        require(manifest.get('storageImage') == image and
                re.fullmatch('[a-f0-9]{40}', manifest.get('storageSourceSha', '')) and
                re.fullmatch('[a-f0-9]{64}', manifest.get('ociLoaderSha256', '')) and
                'storage-v2.oci.tar' in assets, 'STORAGE_OCI_PROVENANCE_REQUIRED')
    else:
        require(not any(field in manifest for field in fields) and 'storage-v2.oci.tar' not in assets,
                'STORAGE_OCI_UNEXPECTED')
    require({name for name in assets if name.endswith('.oci.tar')} == expected_oci, 'OCI_ASSET_BINDING_INVALID')
    if 'storageRuntimeUid' in manifest:
        require(type(manifest['storageRuntimeUid']) is int and manifest['storageRuntimeUid'] == 1000 and local, 'STORAGE_RUNTIME_UID_INVALID')
        require(compose['services']['storage'].get('user') in (None, '1000:1000'), 'STORAGE_RUNTIME_USER_OVERRIDE')


def no_interpolation(value):
    if isinstance(value, str):
        require('$' not in value, 'COMPOSE_INTERPOLATION_REJECTED')
    elif isinstance(value, dict):
        for key, item in value.items():
            no_interpolation(key)
            no_interpolation(item)
    elif isinstance(value, list):
        for item in value:
            no_interpolation(item)


def resource_name(value):
    require(isinstance(value, str) and re.fullmatch(r'[a-z][a-z0-9_]{0,40}', value), 'RESOURCE_NAME_INVALID')
    return value


def validate_compose(compose, *, project=None, snapshots=None):
    require(isinstance(compose, dict), 'COMPOSE_CONTRACT_INVALID')
    effective = project is not None
    if effective:
        require(re.fullmatch(r'enigm-[a-f0-9]{24}', project or ''), 'PROJECT_SCOPE_INVALID')
        require(compose.get('name') == project, 'PROJECT_SCOPE_INVALID')
    else:
        require('name' not in compose, 'PROJECT_OVERRIDE_REJECTED')
    require(set(compose) <= {'name', 'services', 'volumes', 'networks', 'version'}, 'HOST_CONFIG_REJECTED')
    volumes = compose.get('volumes') or {}
    networks = compose.get('networks') or {}
    require(isinstance(volumes, dict) and isinstance(networks, dict), 'RESOURCE_CONTRACT_INVALID')
    for name, volume in volumes.items():
        resource_name(name)
        require(volume is None or isinstance(volume, dict), 'HOST_VOLUME_REJECTED')
        value = volume or {}
        if effective:
            require(set(value) <= {'name'} and value.get('name') == project + '_' + name, 'HOST_VOLUME_REJECTED')
        else:
            require(not value, 'HOST_VOLUME_REJECTED')
    for name, network in networks.items():
        resource_name(name)
        value = network or {}
        require(isinstance(value, dict), 'EXTERNAL_NETWORK_REJECTED')
        allowed = {'driver', 'internal', 'enable_ipv6', 'attachable', 'labels'}
        if effective:
            allowed |= {'name', 'ipam'}
            require(value.get('name') == project + '_' + name and not value.get('ipam'), 'EXTERNAL_NETWORK_REJECTED')
        require(set(value) <= allowed and value.get('driver') in (None, 'bridge'), 'EXTERNAL_NETWORK_REJECTED')
        require(value.get('attachable') in (None, False), 'EXTERNAL_NETWORK_REJECTED')
        no_interpolation(value)
    services = compose.get('services', {})
    require(isinstance(services, dict) and 1 <= len(services) <= 20, 'SERVICES_INVALID')
    allowed_fields = {'image', 'pull_policy', 'command', 'entrypoint', 'security_opt', 'logging', 'healthcheck',
                      'ports', 'volumes', 'env_file', 'environment', 'networks', 'depends_on', 'restart', 'init',
                      'read_only', 'user', 'working_dir', 'tmpfs', 'cap_drop', 'ulimits', 'shm_size', 'mem_limit',
                      'mem_reservation', 'memswap_limit', 'cpus', 'cpu_shares', 'pids_limit', 'stop_grace_period',
                      'stop_signal', 'labels', 'x-enigm-mtls-ingress-v2', 'network_mode', 'pid', 'ipc', 'cgroup',
                      'privileged', 'build', 'cap_add', 'devices', 'volumes_from', 'extends', 'external_links', 'userns_mode'}
    for name, service in services.items():
        resource_name(name)
        require(isinstance(service, dict) and set(service) <= allowed_fields, 'SERVICE_CONTRACT_INVALID')
        reference = '${ENIGM_SECRET_' + name.upper() + ':?private file reference required}'
        env_file = service.get('env_file')
        if effective:
            expected = snapshots.get(name) if isinstance(snapshots, dict) else None
            require((expected is None and env_file in (None, [])) or
                    (expected is not None and isinstance(env_file, list) and len(env_file) == 1), 'ENV_REFERENCE_INVALID')
            if expected is not None:
                item = env_file[0]
                require(isinstance(item, dict) and set(item) <= {'path', 'required', 'format'} and
                        item.get('path') == str(expected) and item.get('required', True) is True and
                        item.get('format') == 'raw', 'ENV_REFERENCE_INVALID')
                no_interpolation(item)
        else:
            require(env_file in (None, [reference]), 'ENV_REFERENCE_INVALID')
        no_interpolation({key: item for key, item in service.items() if key != 'env_file'})
        image = service.get('image', '')
        local_channel = name in ('channel', 'storage') and re.fullmatch(r'sha256:[a-f0-9]{64}', image) and service.get('pull_policy') == 'never'
        require(local_channel or re.fullmatch(r'[a-zA-Z0-9./_-]+@sha256:[a-f0-9]{64}', image), 'IMAGE_DIGEST_REQUIRED')
        require(not service.get('privileged') and service.get('build') is None, 'PRIVILEGE_REJECTED')
        require(all(service.get(key) is None for key in ('network_mode', 'pid', 'ipc', 'cgroup')), 'HOST_NAMESPACE_REJECTED')
        require(not service.get('cap_add') and not service.get('devices'), 'HOST_PRIVILEGE_REJECTED')
        require(not any(service.get(key) for key in ('volumes_from', 'extends', 'external_links', 'userns_mode')), 'HOST_PRIVILEGE_REJECTED')
        require(service.get('security_opt') == ['no-new-privileges:true'], 'PRIVILEGE_POLICY_REQUIRED')
        require(service.get('logging') == {'driver': 'none'}, 'CONTENT_LOGGING_REJECTED')
        health = service.get('healthcheck')
        require(isinstance(health, dict) and isinstance(health.get('test'), list) and len(health['test']) >= 2 and
                health['test'][0] in ('CMD', 'CMD-SHELL') and not health.get('disable'), 'CONTAINER_HEALTHCHECK_REQUIRED')
        for port in service.get('ports') or []:
            require(isinstance(port, dict), 'PUBLIC_PORT_REJECTED')
            ingress = service.get('x-enigm-mtls-ingress-v2')
            private_tls = name == 'channel' and service.get('command') == ['node', 'dist/modules/onprem/onprem-provider-main-v2.js'] and isinstance(ingress, dict) and set(ingress) == {'profile', 'sqlTlsPort', 'httpsPort'} and ingress.get('profile') == 'CENTRAL_BACKEND_MTLS_ONLY' and port.get('target') in (ingress.get('sqlTlsPort'), ingress.get('httpsPort'))
            require(port.get('host_ip') in ('127.0.0.1', '::1') or
                    (private_tls and port.get('host_ip') in ('0.0.0.0', '::')), 'PUBLIC_PORT_REJECTED')
        for volume in service.get('volumes') or []:
            require(isinstance(volume, dict) and set(volume) <= {'type', 'source', 'target', 'read_only', 'volume'} and
                    volume.get('type') == 'volume' and volume.get('source') in volumes, 'HOST_BIND_REJECTED')
            target = volume.get('target')
            require(isinstance(target, str) and target.startswith('/') and '..' not in Path(target).parts,
                    'VOLUME_TARGET_INVALID')
            require(not volume.get('volume') or set(volume['volume']) <= {'nocopy'}, 'VOLUME_OPTIONS_REJECTED')
        attached = service.get('networks') or {}
        require(isinstance(attached, (dict, list)) and all(key in networks for key in attached), 'NETWORK_SCOPE_INVALID')
        require(not service.get('environment'), 'INLINE_ENVIRONMENT_REJECTED')
    no_interpolation({key: value for key, value in compose.items() if key != 'services'})


def private_json_reference(path):
    return json.loads(read_private_bytes(path))


def validate_private_channel(value, release):
    signed = json.loads(read_file_bytes(release / 'manifest.json'))
    channel = value.get('privateChannel')
    require(not signed.get('privateChannelRequired') or channel is not None, 'PRIVATE_CHANNEL_REQUIRED')
    if channel is None:
        return
    require(isinstance(channel, dict) and set(channel) == {'manifestFile', 'providerRuntimeFile'}, 'PRIVATE_CHANNEL_REFERENCES_INVALID')
    manifest = private_json_reference(Path(channel['manifestFile']))
    provider = private_json_reference(Path(channel['providerRuntimeFile']))
    require(manifest.get('contract') == 'enigm-onprem-channel-preparation-v2' and manifest.get('product') == '2.1' and manifest.get('phase') == 'PREPARED' and manifest.get('centralActivationRequired') is True and manifest.get('admissionEnabled') is False, 'PRIVATE_CHANNEL_CONTRACT_INVALID')
    expected = {'version', 'runtimeRole', 'runtimePassword', 'providerJwtSecret', 'clientCaPem', 'serverKeyPem', 'serverCertPem', 'clientSpkiSha256', 'binding', 'generation', 'sqlPort', 'httpsPort', 'dbPort', 'storagePort'}
    require(set(provider) == expected and provider.get('version') == 2 and provider.get('generation') == manifest.get('generation') and provider.get('binding') == manifest.get('binding') and provider.get('runtimeRole') == manifest.get('runtimeRole') and provider.get('clientSpkiSha256') == manifest.get('clientSpkiSha256'), 'PRIVATE_CHANNEL_SCOPE_INVALID')
    require(provider['binding'].get('backendArtifactSha256') == signed.get('backendArtifact') and provider['binding'].get('provider') == 'SELF_HOSTED', 'PRIVATE_CHANNEL_ARTIFACT_INVALID')
    services = json.loads(read_file_bytes(release / 'compose.json')).get('services', {})
    require(signed.get('backendImagePayloadVerified') is True, 'PRIVATE_CHANNEL_IMAGE_PROOF_REQUIRED')
    require(signed.get('providerBootstrapRequired') is True, 'PRIVATE_CHANNEL_BOOTSTRAP_REQUIRED')
    require(set(services) == {'db', 'rest', 'storage', 'realtime', 'channel'}, 'PRIVATE_PROVIDER_PROFILE_REQUIRED')
    require(signed.get('backendChannelImage') == services.get('channel', {}).get('image'), 'PRIVATE_CHANNEL_IMAGE_INVALID')
    ingress = services.get('channel', {}).get('x-enigm-mtls-ingress-v2')
    require(ingress == {'profile': 'CENTRAL_BACKEND_MTLS_ONLY', 'sqlTlsPort': provider.get('sqlPort'), 'httpsPort': provider.get('httpsPort')}, 'PRIVATE_CHANNEL_INGRESS_INVALID')
    require(all(port.get('target') in [provider.get('sqlPort'), provider.get('httpsPort')] for port in services['channel'].get('ports', [])), 'PRIVATE_CHANNEL_INGRESS_INVALID')
    require('channel' in services and services['channel'].get('command') == ['node', 'dist/modules/onprem/onprem-provider-main-v2.js'], 'PRIVATE_CHANNEL_SERVICE_REQUIRED')
    channel_file = regular(Path(value.get('serviceFiles', {}).get('channel', '')), True)
    require(channel_file.stat().st_size <= 65536 and channel_file.stat().st_nlink == 1, 'PRIVATE_CHANNEL_ENV_INVALID')
    descriptor = os.open(channel_file, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        channel_info = os.fstat(descriptor)
        require(channel_info.st_uid == os.getuid() and channel_info.st_mode & 0o077 == 0 and channel_info.st_nlink == 1 and stat.S_ISREG(channel_info.st_mode), 'PRIVATE_CHANNEL_ENV_INVALID')
        lines = os.read(descriptor, 65537).decode('utf8').splitlines()
    finally:
        os.close(descriptor)
    environment = {}
    for line in lines:
        require('=' in line and not line.startswith('#'), 'PRIVATE_CHANNEL_ENV_INVALID')
        name, content = line.split('=', 1)
        require(name not in environment, 'PRIVATE_CHANNEL_ENV_INVALID')
        environment[name] = content
    require(set(environment) == {'ENIGM_ONPREM_PROVIDER_CHANNEL_V2_ENABLED', 'ENIGM_ONPREM_PROVIDER_CHANNEL_CONFIG_V2', 'ENIGM_ONPREM_PROVIDER_DB_OPERATOR_PASSWORD_V2'} and environment['ENIGM_ONPREM_PROVIDER_CHANNEL_V2_ENABLED'] == 'true' and json.loads(environment['ENIGM_ONPREM_PROVIDER_CHANNEL_CONFIG_V2']) == provider and 32 <= len(environment['ENIGM_ONPREM_PROVIDER_DB_OPERATOR_PASSWORD_V2']) <= 512, 'PRIVATE_CHANNEL_ENV_INVALID')

    require(isinstance(provider.get('runtimePassword'), str) and 32 <= len(provider['runtimePassword']) <= 512 and re.fullmatch('[a-f0-9]{64}', provider.get('providerJwtSecret', '')), 'PRIVATE_CHANNEL_SECRET_INVALID')
    # Central client private keys and CA signing keys must never ship here. Exact
    # field allowlist above excludes both, as well as KMS/Hanko/central DB secrets.
    with tempfile.TemporaryDirectory(prefix='.enigm-channel-verify-', dir=Path.home()) as directory:
        root = Path(directory); root.chmod(0o700)
        for name, field in [('server.key', 'serverKeyPem'), ('server.pem', 'serverCertPem'), ('ca.pem', 'clientCaPem')]:
            target = root / name
            target.write_text(provider[field]); target.chmod(0o600)
        public = run(['openssl', 'x509', '-in', str(root / 'server.pem'), '-pubkey', '-noout'], True)
        public_path = root / 'server.pub'; public_path.write_bytes(public); public_path.chmod(0o600)
        cert_spki = run(['openssl', 'pkey', '-pubin', '-in', str(public_path), '-outform', 'DER'], True)
        key_spki = run(['openssl', 'pkey', '-in', str(root / 'server.key'), '-pubout', '-outform', 'DER'], True)
        require(cert_spki == key_spki and hashlib.sha256(cert_spki).hexdigest() == manifest.get('serverSpkiSha256'), 'PRIVATE_CHANNEL_TLS_KEY_MISMATCH')
        run(['openssl', 'verify', '-CAfile', str(root / 'ca.pem'), '-purpose', 'sslserver', '-verify_hostname', provider['binding']['poolerHost'], str(root / 'server.pem')])


def secret_references(reference, release):
    value = private_json_reference(reference)
    require(value.get('contract') == 'enigm-onprem-secret-references-v2' and
            isinstance(value.get('serviceFiles'), dict), 'SECRET_REFERENCE_CONTRACT_INVALID')
    services = json.loads(read_file_bytes(release / 'compose.json'))['services']
    required = {name for name, service in services.items() if service.get('env_file')}
    require(set(value['serviceFiles']) == required, 'SECRET_REFERENCE_SCOPE_INVALID')
    files = {}
    for name, path in value['serviceFiles'].items():
        files[name] = regular(Path(path), True)
        require(files[name].stat().st_size <= 65536, 'SECRET_FILE_TOO_LARGE')
    require(len(set(files.values())) == len(files), 'SHARED_SERVICE_SECRETS_REJECTED')
    validate_private_channel(value, release)
    return files


def command_environment(home, endpoint=None, docker_config=None):
    value = {'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': str(home), 'LANG': 'C.UTF-8',
             'LC_ALL': 'C.UTF-8', 'COMPOSE_DISABLE_ENV_FILE': '1'}
    if endpoint is not None:
        require(isinstance(endpoint, str) and re.fullmatch(r'unix:///(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+', endpoint) and
                not endpoint.startswith('unix:////') and not any(character.isspace() for character in endpoint) and
                not any(character in endpoint for character in ('\x00', '$', '?', '#', '\\')) and
                '..' not in endpoint[7:].split('/'), 'LOCAL_DOCKER_SOCKET_REQUIRED')
        value['DOCKER_HOST'] = endpoint
    if docker_config is not None:
        value['DOCKER_CONFIG'] = str(docker_config)
    return value


@contextlib.contextmanager
def secret_snapshot_context(root, reference, release):
    private_directory(root)
    value = private_json_reference(reference)
    require(isinstance(value, dict) and value.get('contract') == 'enigm-onprem-secret-references-v2' and
            isinstance(value.get('serviceFiles'), dict), 'SECRET_REFERENCE_CONTRACT_INVALID')
    model = json.loads(read_file_bytes(release / 'compose.json'))
    required = {name for name, service in model['services'].items() if service.get('env_file')}
    require(set(value['serviceFiles']) == required, 'SECRET_REFERENCE_SCOPE_INVALID')
    with tempfile.TemporaryDirectory(prefix='.runtime-', dir=root) as name:
        directory = Path(name)
        directory.chmod(0o700)
        files = snapshot_secret_files({key: Path(path) for key, path in value['serviceFiles'].items()}, directory)
        captured = dict(value)
        captured['serviceFiles'] = {key: str(path) for key, path in files.items()}
        channel = value.get('privateChannel')
        if channel is not None:
            require(isinstance(channel, dict) and set(channel) == {'manifestFile', 'providerRuntimeFile'}, 'PRIVATE_CHANNEL_REFERENCES_INVALID')
            captured['privateChannel'] = {}
            for field, filename in (('manifestFile', 'channel-manifest.json'), ('providerRuntimeFile', 'provider-runtime.json')):
                target = write_private_bytes(directory / filename, read_private_bytes(Path(channel[field])))
                captured['privateChannel'][field] = str(target)
        validate_private_channel(captured, release)
        config = directory / 'docker-config'
        config.mkdir(mode=0o700)
        write_private_bytes(config / 'config.json', b'{}')
        write_private_bytes(directory / 'empty.env', b'')
        yield directory, files, config


def materialized_compose(directory, release, project, files, env):
    require(re.fullmatch(r'enigm-[a-f0-9]{24}', project or ''), 'PROJECT_SCOPE_INVALID')
    model = json.loads(read_file_bytes(release / 'compose.json'))
    validate_compose(model)
    for name, service in model['services'].items():
        if name in files:
            service['env_file'] = [{'path': str(files[name]), 'required': True, 'format': 'raw'}]
    no_interpolation(model)
    source = write_private_bytes(directory / 'source-compose.json', json.dumps(model, sort_keys=True).encode())
    base = ['docker', 'compose', '--project-name', project, '--project-directory', str(directory),
            '--env-file', str(directory / 'empty.env')]
    result = subprocess.run([*base, '--file', str(source), 'config', '--format', 'json', '--no-env-resolution'],
                            env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60, check=False)
    require(result.returncode == 0 and len(result.stdout) <= 1024 * 1024, 'COMPOSE_MATERIALIZATION_FAILED')
    effective = json.loads(result.stdout)
    validate_compose(effective, project=project, snapshots=files)
    encoded = json.dumps(effective, sort_keys=True, separators=(',', ':')).encode()
    target = write_private_bytes(directory / 'effective-compose.json', encoded)
    # Check idempotence through the same parser before any runtime side effect.
    check = subprocess.run([*base, '--file', str(target), 'config', '--format', 'json', '--no-env-resolution'],
                           env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60, check=False)
    require(check.returncode == 0 and len(check.stdout) <= 1024 * 1024, 'COMPOSE_MATERIALIZATION_FAILED')
    repeated = json.loads(check.stdout)
    validate_compose(repeated, project=project, snapshots=files)
    require(repeated == effective, 'COMPOSE_REINTERPRETATION_REJECTED')
    return [*base, '--file', str(target)], target, hashlib.sha256(encoded).hexdigest()


def local_docker_endpoint():
    endpoint = os.environ.get('DOCKER_HOST')
    if endpoint is None:
        selected = subprocess.run(['docker', 'context', 'inspect', '--format', '{{json .Endpoints.docker.Host}}'],
                                  env=command_environment(Path.home()), stdout=subprocess.PIPE,
                                  stderr=subprocess.PIPE, timeout=30, check=False)
        require(selected.returncode == 0 and len(selected.stdout) <= 16384, 'LOCAL_DOCKER_SOCKET_REQUIRED')
        endpoint = json.loads(selected.stdout)
    command_environment(Path.home(), endpoint)
    return endpoint


def compose(root, release, action, secret, recovery=None, endpoint=None, backup_verified=False):
    with secret_snapshot_context(root, secret, release) as (directory, files, config):
        endpoint = local_docker_endpoint() if endpoint is None else endpoint
        env = command_environment(directory, endpoint, config)
        info = subprocess.run(['docker', 'info', '--format', '{{json .SecurityOptions}}'],
                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30, check=False)
        require(info.returncode == 0 and len(info.stdout) <= 16384, 'ROOTLESS_DOCKER_REQUIRED')
        options = json.loads(info.stdout)
        require(isinstance(options, list) and any('rootless' in option for option in options), 'ROOTLESS_DOCKER_REQUIRED')
        require(os.getuid() != 0, 'ROOT_EXECUTION_REJECTED')
        project = private_json_reference(root / 'state.json')['project']
        base, effective_path, effective_digest = materialized_compose(directory, release, project, files, env)
        _compose_action(root, release, action, recovery, env, base, effective_path, effective_digest, backup_verified)


def checked_compose_call(command, env, effective_path, effective_digest):
    require(hashlib.sha256(read_private_bytes(effective_path, 1024 * 1024)).hexdigest() == effective_digest,
            'COMPOSE_CONFIGURATION_CHANGED')
    return subprocess.run(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=300, check=False)


def storage_volume_reference(effective, project):
    require(re.fullmatch(r'enigm-[a-f0-9]{24}', project), 'STORAGE_PROJECT_INVALID')
    storage = effective.get('services', {}).get('storage', {})
    mounts = storage.get('volumes', [])
    require(len(mounts) == 1, 'STORAGE_VOLUME_MOUNT_INVALID')
    mount = mounts[0]
    require(isinstance(mount, dict) and mount.get('type') == 'volume' and
            mount.get('source') == 'storage_data' and mount.get('target') == '/var/lib/storage' and
            mount.get('read_only') is not True and not mount.get('bind'), 'STORAGE_VOLUME_MOUNT_INVALID')
    volume = effective.get('volumes', {}).get('storage_data', {})
    expected = project + '_storage_data'
    require(volume.get('name') == expected and not volume.get('external') and
            volume.get('driver') in (None, 'local') and not volume.get('driver_opts'), 'STORAGE_VOLUME_SCOPE_INVALID')
    return expected


def migration_docker_call(arguments, env):
    result = subprocess.run(['docker', *arguments], env=env, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, timeout=300, check=False)
    require(result.returncode == 0 and len(result.stdout) <= 16384, 'STORAGE_OWNERSHIP_MIGRATION_FAILED')
    return result.stdout


def verify_storage_volume(volume, project, env):
    inspected = json.loads(migration_docker_call(['volume', 'inspect', volume], env))
    require(isinstance(inspected, list) and len(inspected) == 1, 'STORAGE_VOLUME_INSPECTION_INVALID')
    details = inspected[0]
    require(details.get('Name') == volume and details.get('Driver') == 'local' and not details.get('Options'), 'STORAGE_VOLUME_DRIVER_INVALID')
    labels = details.get('Labels') or {}
    require(labels.get('com.docker.compose.project') == project and labels.get('com.docker.compose.volume') == 'storage_data', 'STORAGE_VOLUME_OWNERSHIP_INVALID')


def cleanup_storage_migrator(name, nonce, image, env):
    ids = migration_docker_call(['ps', '-aq', '--no-trunc', '--filter', 'name=^/' + name + '$',
                                '--filter', 'label=enigm.storage-migration=' + nonce], env).decode().split()
    require(len(ids) <= 1, 'STORAGE_MIGRATOR_IDENTITY_INVALID')
    for identifier in ids:
        require(re.fullmatch(r'[a-f0-9]{64}', identifier), 'STORAGE_MIGRATOR_IDENTITY_INVALID')
        details = json.loads(migration_docker_call(['inspect', identifier], env))
        require(isinstance(details, list) and len(details) == 1, 'STORAGE_MIGRATOR_IDENTITY_INVALID')
        value = details[0]
        require(value.get('Id') == identifier and value.get('Name') == '/' + name and
                value.get('Image') == image and
                (value.get('Config', {}).get('Labels') or {}).get('enigm.storage-migration') == nonce,
                'STORAGE_MIGRATOR_IDENTITY_INVALID')
        migration_docker_call(['rm', '--force', identifier], env)


def run_storage_migrator(volume, image, env):
    active = migration_docker_call(['ps', '-q', '--filter', 'volume=' + volume], env).strip()
    require(not active, 'STORAGE_VOLUME_IN_USE')
    nonce = os.urandom(16).hex()
    name = 'enigm-storage-migration-' + nonce
    try:
        migration_docker_call(['create', '--name', name, '--label', 'enigm.storage-migration=' + nonce,
            '--pull=never', '--network', 'none', '--read-only', '--cap-drop=ALL',
            '--cap-add=CHOWN', '--cap-add=DAC_READ_SEARCH', '--security-opt', 'no-new-privileges',
            '--user', '0:0', '--pids-limit', '64', '--memory', '128m', '--cpus', '1', '--mount',
            'type=volume,source=' + volume + ',target=/var/lib/storage,volume-nocopy',
            '--entrypoint', 'node', image, '/opt/enigm-storage-tus-delete/storage-volume-ownership-v2.cjs'], env)
        return json.loads(migration_docker_call(['start', '--attach', name], env))
    finally:
        # A timed-out Docker client does not stop its container. Remove only the
        # exact image/name/nonce-owned migrator before allowing any retry.
        cleanup_storage_migrator(name, nonce, image, env)


def prepare_storage_ownership(root, release, signed, env, base, effective_path, effective_digest, backup_verified):
    state = private_json_reference(root / 'state.json')
    image = signed.get('storageImage', '')
    require(re.fullmatch(r'sha256:[a-f0-9]{64}', image), 'STORAGE_MIGRATION_IMAGE_INVALID')
    user = json.loads(migration_docker_call(['image', 'inspect', '--format', '{{json .Config.User}}', image], env))
    require(user == '1000:1000', 'STORAGE_NONROOT_IMAGE_REQUIRED')
    if state.get('active') == release.name:
        return  # This committed release already completed its ownership transition.
    require(state.get('active') is None or backup_verified is True, 'STORAGE_MIGRATION_BACKUP_REQUIRED')
    effective = json.loads(read_private_bytes(effective_path, 1024 * 1024))
    project = state['project']
    volume = storage_volume_reference(effective, project)
    stopped = checked_compose_call([*base, 'stop', '--timeout', '30', 'channel', 'storage'], env, effective_path, effective_digest)
    require(stopped.returncode == 0, 'STORAGE_MIGRATION_STOP_FAILED')
    existing = migration_docker_call(['volume', 'ls', '--filter', 'name=^' + volume + '$', '--format', '{{.Name}}'], env).decode().splitlines()
    require(existing in ([], [volume]), 'STORAGE_VOLUME_INSPECTION_INVALID')
    if existing:
        verify_storage_volume(volume, project, env)
    created = checked_compose_call([*base, 'create', '--no-deps', 'storage'], env, effective_path, effective_digest)
    require(created.returncode == 0, 'STORAGE_MIGRATION_CREATE_FAILED')
    verify_storage_volume(volume, project, env)
    # Root is confined to this stopped project's local Storage volume. No provider
    # environment or authentication material is passed to the migration process.
    proof = run_storage_migrator(volume, image, env)
    require(isinstance(proof, dict) and proof.get('contract') == 'enigm-storage-volume-ownership-v2' and
            proof.get('uid') == 1000 and proof.get('gid') == 1000 and proof.get('contentVerified') is True,
            'STORAGE_OWNERSHIP_PROOF_INVALID')


def _compose_action(root, release, action, recovery, env, base, effective_path, effective_digest, backup_verified=False):
    command = [*base, 'up', '--detach', '--wait', '--wait-timeout', '180'] if action in ('up', 'recover-channel') else [*base, 'stop', '--timeout', '30']
    signed = json.loads(read_file_bytes(release / 'manifest.json'))
    if action in ('up', 'recover-channel') and signed.get('storageRuntimeUid') == 1000:
        prepare_storage_ownership(root, release, signed, env, base, effective_path, effective_digest, backup_verified)
    if action == 'recover-channel':
        require(signed.get('providerBootstrapRequired') and recovery is not None, 'PRIVATE_CHANNEL_RECOVERY_REQUIRED')
        old = private_json_reference(Path(recovery['oldRuntimeFile']))
        challenge = private_json_reference(Path(recovery['challengeFile']))
        require(challenge.get('purpose') == 'OWNER_CHANNEL_RECOVERY', 'PRIVATE_CHANNEL_RECOVERY_PURPOSE_INVALID')
        env['ENIGM_ONPREM_RECOVERY_OLD_CONFIG_V2'] = json.dumps(old, separators=(',', ':'))
        env['ENIGM_ONPREM_RECOVERY_CHALLENGE_V2'] = json.dumps(challenge, separators=(',', ':'))
        stopped = checked_compose_call([*base, 'stop', '--timeout', '30', 'channel'], env, effective_path, effective_digest)
        require(stopped.returncode == 0, 'PRIVATE_CHANNEL_STOP_FAILED')
        env['ENIGM_ONPREM_RECOVERY_CHANNEL_STOPPED_V2'] = 'true'
        local = checked_compose_call([*base, 'run', '--rm', '--no-deps', '--env', 'ENIGM_ONPREM_RECOVERY_OLD_CONFIG_V2', '--env', 'ENIGM_ONPREM_RECOVERY_CHALLENGE_V2', '--env', 'ENIGM_ONPREM_RECOVERY_CHANNEL_STOPPED_V2', '--entrypoint', 'node', 'channel', 'dist/modules/onprem/onprem-local-channel-recovery-v2.js'], env, effective_path, effective_digest)
        require(local.returncode == 0 and len(local.stdout) <= 16384, 'PRIVATE_CHANNEL_LOCAL_RECOVERY_FAILED')
        proof = json.loads(local.stdout)
        require(isinstance(proof, dict) and proof.get('challenge') == challenge and isinstance(proof.get('signature'), str), 'PRIVATE_CHANNEL_RECOVERY_PROOF_INVALID')
        target = Path(recovery['proofFile'])
        require(not target.exists() and target.parent.stat().st_uid == os.getuid() and target.parent.stat().st_mode & 0o077 == 0, 'PRIVATE_CHANNEL_RECOVERY_OUTPUT_INVALID')
        descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(proof, stream, sort_keys=True)
    if action == 'up' and signed.get('providerBootstrapRequired'):
        setup = [
            [*base, 'up', '--detach', '--wait', '--wait-timeout', '180', 'db'],
            [*base, 'run', '--rm', '--no-deps', '--entrypoint', 'node', 'channel', 'dist/modules/onprem/onprem-provider-bootstrap-v2.js', '--upstream-roles'],
            [*base, 'up', '--detach', '--wait', '--wait-timeout', '180', 'db', 'rest', 'storage', 'realtime'],
            [*base, 'run', '--rm', '--no-deps', '--entrypoint', 'node', 'channel', 'dist/modules/onprem/onprem-provider-bootstrap-v2.js'],
        ]
        for step in setup:
            phase = checked_compose_call(step, env, effective_path, effective_digest)
            require(phase.returncode == 0, 'PRIVATE_PROVIDER_BOOTSTRAP_FAILED')
    result = checked_compose_call(command, env, effective_path, effective_digest)
    if result.returncode:
        diagnostic = result.stderr.decode(errors='replace').lower()
        diagnostic += result.stdout.decode(errors='replace').lower()
        code = 'COMPOSE_HEALTH_FAILED'
        for patterns, category in [
            (['unknown flag', 'unknown command'], 'COMPOSE_VERSION_UNSUPPORTED'),
            (['pull access denied', 'manifest unknown', 'failed to resolve', 'toomanyrequests'], 'IMAGE_PULL_FAILED'),
            (['permission denied'], 'CONTAINER_PERMISSION_DENIED'),
            (['unhealthy'], 'CONTAINER_UNHEALTHY'),
            (['exited'], 'CONTAINER_EXITED'),
        ]:
            if any(pattern in diagnostic for pattern in patterns):
                code = category
                break
        failure = Rejected(code)
        vocabulary = {'image', 'pull', 'manifest', 'digest', 'denied', 'permission', 'network',
                      'volume', 'mount', 'bind', 'unhealthy', 'exited', 'exit', 'restarting',
                      'dependency', 'condition', 'unknown', 'unsupported', 'flag', 'command',
                      'daemon', 'connect', 'failed', 'invalid', 'timeout', 'error', 'not', 'found',
                      'copy', 'populate', 'create', 'chown', 'chmod', 'metadata', 'links', 'symbolic',
                      'symlink', 'levels', 'many', 'space', 'file', 'directory', 'resource', 'busy',
                      'overlay', 'xattrs', 'readonly', 'support', 'supported', 'read', 'only', 'quota',
                      'operation', 'permitted', 'argument', 'cgroup', 'namespace'}
        failure.keywords = sorted(set(re.findall(r'[a-z]+', diagnostic)) & vocabulary)
        raise failure


def atomic_json(path, value):
    descriptor, name = tempfile.mkstemp(prefix='.state-', dir=path.parent)
    temp = Path(name)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(value, stream, sort_keys=True)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, path)
        fsync_directory(path.parent)
    finally:
        temp.unlink(missing_ok=True)


def fsync_directory(path):
    with parent_descriptor(Path(path) / '.directory-check') as descriptor:
        os.fsync(descriptor)


def switch(root, pin):
    require(re.fullmatch(r'[a-f0-9]{64}', pin or ''), 'RELEASE_REFERENCE_INVALID')
    private_directory(root)
    descriptor, name = tempfile.mkstemp(prefix='.current-', dir=root)
    os.close(descriptor)
    link = Path(name)
    link.unlink()
    try:
        link.symlink_to(Path('releases') / pin, target_is_directory=True)
        os.replace(link, root / 'current')
        fsync_directory(root)
    finally:
        link.unlink(missing_ok=True)


def lifecycle(args):
    require(sys.platform.startswith('linux'), 'LINUX_REQUIRED')
    root = Path(args.root).absolute()
    require(not root.is_symlink(), 'INSTALL_ROOT_INVALID')
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    require(root.stat().st_uid == os.getuid() and root.stat().st_mode & 0o077 == 0, 'INSTALL_ROOT_PERMISSIONS_INVALID')
    with (root / '.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        secret = regular(Path(args.secrets_file).absolute(), True)
        bundle = Path(args.bundle).absolute()
        key = Path(args.trust_key).absolute()
        manifest = verify(bundle, args.manifest_sha256, key, args.trust_key_sha256)
        secret_references(secret, bundle)
        state_path = root / 'state.json'
        state = private_json_reference(state_path) if state_path.exists() else None
        require(args.command == 'install' or state is not None, 'INSTALLATION_REQUIRED')
        if state:
            require(state['secretReference'] == str(secret), 'SECRET_REFERENCE_CHANGE_REJECTED')
        if args.command == 'install' and state:
            require(state['active'] in [None, args.manifest_sha256], 'USE_UPDATE_FOR_NEW_RELEASE')
        backup_verified = False
        if args.command in ['update', 'recover-channel'] and state['active'] != args.manifest_sha256:
            require(state['active'] in manifest.get('upgradesFrom', []), 'UPDATE_COMPATIBILITY_UNVERIFIED')
            require(args.backup_receipt, 'ENCRYPTED_BACKUP_RECEIPT_REQUIRED')
            receipt = private_json_reference(Path(args.backup_receipt).absolute())
            require(receipt.get('release') == state['active'] and receipt.get('restoreDrillPassed') is True, 'RESTORE_DRILL_REQUIRED')
            artifact = regular(Path(receipt['encryptedBackupReference']).absolute(), True)
            require(digest(artifact) == receipt.get('sha256') and artifact.stat().st_size > 0, 'BACKUP_CHECKSUM_INVALID')
            backup_verified = True
        if args.command == 'recover':
            # Reinstall exactly the committed release. Never roll a database back implicitly.
            require(state['active'] == args.manifest_sha256, 'RECOVERY_RELEASE_MISMATCH')
        releases = root / 'releases'
        releases.mkdir(mode=0o700, exist_ok=True)
        release = releases / args.manifest_sha256
        if release.exists():
            verify(release, args.manifest_sha256, key, args.trust_key_sha256)
        else:
            temp = Path(tempfile.mkdtemp(prefix='.stage-', dir=releases))
            try:
                for name in ['manifest.json', 'manifest.sig', *manifest['assets']]:
                    target = temp / name
                    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                    shutil.copyfile(bundle / name, target)
                    target.chmod(0o600)
                verify(temp, args.manifest_sha256, key, args.trust_key_sha256)
                os.rename(temp, release)
            finally:
                if temp.exists():
                    shutil.rmtree(temp)
        if state is None:
            state = {'contract': 'enigm-onprem-install-state-v2', 'project': 'enigm-' + os.urandom(12).hex(),
                     'active': None, 'secretReference': str(secret)}
            atomic_json(state_path, state)
        # Preparation is deliberately a separate, testable mode. It never claims service health.
        if args.prepare_only:
            state['prepared'] = args.manifest_sha256
            atomic_json(state_path, state)
            return {'result': 'VERIFIED_PREPARED', 'runtimeVerified': False}
        endpoint = None
        remaining_expansion = 2 * 1024 * 1024 * 1024
        if manifest.get('backendChannelImage', '').startswith('sha256:'):
            endpoint = local_docker_endpoint()
            loader = Path(__file__).with_name('enigm-image-load-v2.py')
            require(digest(regular(loader)) == manifest.get('ociLoaderSha256'), 'OCI_LOADER_PIN_INVALID')
            asset = manifest['assets']['backend-v2.oci.tar']
            loaded = json.loads(run([sys.executable, '-I', str(loader), '--archive', str(release / 'backend-v2.oci.tar'), '--source-sha', manifest['backendSourceSha'], '--archive-sha256', asset['sha256'], '--load-rootless', '--docker-host', endpoint], True, timeout=600))
            require(loaded.get('imageId') == manifest['backendChannelImage'] and loaded.get('rootlessLoaded') is True, 'LOCAL_IMAGE_LOADED_ID_MISMATCH')
            if manifest.get('storageImage'):
                expanded = loaded.get('expandedLayerBytes')
                require(type(expanded) is int and 0 < expanded < remaining_expansion, 'OCI_EXPANSION_BUDGET_INVALID')
                remaining_expansion -= expanded
        if manifest.get('storageImage', '').startswith('sha256:'):
            endpoint = endpoint or local_docker_endpoint()
            loader = Path(__file__).with_name('enigm-image-load-v2.py')
            require(digest(regular(loader)) == manifest.get('ociLoaderSha256'), 'OCI_LOADER_PIN_INVALID')
            asset = manifest['assets']['storage-v2.oci.tar']
            loaded = json.loads(run([sys.executable, '-I', str(loader), '--archive', str(release / 'storage-v2.oci.tar'), '--source-sha', manifest['storageSourceSha'], '--archive-sha256', asset['sha256'], '--max-expanded-bytes', str(remaining_expansion), '--load-rootless', '--docker-host', endpoint], True, timeout=600))
            require(loaded.get('imageId') == manifest['storageImage'] and loaded.get('rootlessLoaded') is True, 'STORAGE_IMAGE_LOADED_ID_MISMATCH')
        if args.command == 'recover-channel':
            require(args.old_provider_runtime and args.recovery_challenge and args.recovery_proof, 'PRIVATE_CHANNEL_RECOVERY_REFERENCES_REQUIRED')
            compose(root, release, 'recover-channel', secret, {'oldRuntimeFile': args.old_provider_runtime, 'challengeFile': args.recovery_challenge, 'proofFile': args.recovery_proof}, endpoint=endpoint, backup_verified=backup_verified)
            state['channelRecoveryPrepared'] = args.manifest_sha256
            atomic_json(state_path, state)
            return {'result': 'CHANNEL_RECOVERY_PREPARED', 'runtimeVerified': False, 'centralCommitRequired': True}
        compose(root, release, 'up', secret, endpoint=endpoint, backup_verified=backup_verified)
        state['previous'] = state.get('active')
        state['active'] = args.manifest_sha256
        atomic_json(state_path, state)
        switch(root, args.manifest_sha256)
        return {'result': 'INSTALLED_HEALTHY', 'runtimeVerified': True}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['install', 'update', 'recover', 'recover-channel'])
    for flag in ['root', 'bundle', 'manifest-sha256', 'trust-key', 'trust-key-sha256', 'secrets-file']:
        parser.add_argument('--' + flag, required=True)
    parser.add_argument('--backup-receipt')
    parser.add_argument('--old-provider-runtime')
    parser.add_argument('--recovery-challenge')
    parser.add_argument('--recovery-proof')
    parser.add_argument('--prepare-only', action='store_true')
    args = parser.parse_args()
    try:
        print(json.dumps(lifecycle(args)))
    except Rejected as error:
        code = str(error) if re.fullmatch(r'[A-Z0-9_]{3,80}', str(error)) else 'OPERATION_REJECTED'
        print(json.dumps({'result': 'REJECTED', 'code': code,
                          'keywords': getattr(error, 'keywords', []), 'runtimeVerified': False}), file=sys.stderr)
        return 1
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        # Never print a provider response or a private path/value in diagnostic output.
        print(json.dumps({'result': 'REJECTED', 'runtimeVerified': False}), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
